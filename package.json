{
  "name": "ai-bot-access",
  "version": "0.2.0",
  "description": "Can ChatGPT, Claude, Google and LinkedIn actually read your site? Checks 24 AI, search and link-preview bots against robots.txt and your real server, checks your share preview, verifies bot IPs and reads access logs.",
  "keywords": [
    "robots.txt",
    "ai crawlers",
    "gptbot",
    "claudebot",
    "perplexitybot",
    "oai-searchbot",
    "googlebot",
    "bingbot",
    "linkedinbot",
    "open graph",
    "og image",
    "link preview",
    "verify bot ip",
    "fake bots",
    "access logs",
    "geo",
    "aeo",
    "seo",
    "llm",
    "crawler",
    "cli"
  ],
  "license": "MIT",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "homepage": "https://codevibe.in/tools/ai-bot-access?utm_source=npm&utm_medium=package&utm_campaign=ai-bot-access",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/ai-bot-access.git"
  },
  "bugs": "https://github.com/codevibe-technology/ai-bot-access/issues",
  "type": "module",
  "bin": {
    "ai-bot-access": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "node scripts/readme-utm.mjs npm",
    "postpack": "node scripts/readme-utm.mjs restore"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
