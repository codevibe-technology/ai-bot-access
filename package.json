{
  "name": "ai-bot-access",
  "version": "0.1.0",
  "description": "Check whether AI crawlers (GPTBot, ClaudeBot, PerplexityBot, OAI-SearchBot and more) can actually read your pages: robots.txt rules plus a real request with each bot's user agent.",
  "keywords": [
    "robots.txt",
    "ai crawlers",
    "gptbot",
    "claudebot",
    "perplexitybot",
    "oai-searchbot",
    "geo",
    "aeo",
    "seo",
    "llm",
    "crawler",
    "cli"
  ],
  "license": "MIT",
  "author": "Codevibe Technology <hello@codevibe.in> (https://codevibe.in)",
  "homepage": "https://github.com/codevibe-technology/ai-bot-access#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevibe-technology/ai-bot-access.git"
  },
  "bugs": "https://github.com/codevibe-technology/ai-bot-access/issues",
  "type": "module",
  "bin": {
    "ai-bot-access": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  }
}
